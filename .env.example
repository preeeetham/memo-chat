# --- LLM (any OpenAI-compatible endpoint; defaults shown are for Gemini) ---
LLM_PROVIDER=openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# optional: cheaper/faster model for planning and memory extraction (defaults to LLM_MODEL)
HELPER_MODEL=

# --- Web search (the agent's one tool) ---
SEARCH_PROVIDER=exa            # exa | tavily
EXA_API_KEY=
TAVILY_API_KEY=                # only if SEARCH_PROVIDER=tavily

# --- Dev / eval only ---
MINICHAT_FAKE_NOW=             # ISO timestamp; freezes "now", e.g. 2026-11-11T14:05:00+05:30
MINICHAT_DB_PATH=              # defaults to ./data/minichat.db
