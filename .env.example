# Copy to .env and fill in the two API keys. Everything else has a working default.

# --- LLM (any OpenAI-compatible endpoint; defaults are for Gemini) ---
LLM_API_KEY=                   # required. Gemini: https://aistudio.google.com/apikey
LLM_PROVIDER=openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
HELPER_MODEL=                  # optional: cheaper model for planning and extraction (defaults to LLM_MODEL)
LLM_FALLBACK_MODEL=            # optional: used when the main model is rate-limited or down (answer marked degraded)
EMBEDDING_MODEL=gemini-embedding-001   # optional: hybrid recall (full text + vectors). Empty = full text only

# --- Web search (the agent's one tool) ---
EXA_API_KEY=                   # required for exa. https://exa.ai (free tier works)
SEARCH_PROVIDER=exa            # exa | tavily
SEARCH_FALLBACK_PROVIDER=      # optional: tavily, used when the primary provider fails
TAVILY_API_KEY=

# --- Sign-in ---
AUTH_MODE=dev                  # dev: pick a username, no password (local only). oidc: real identity provider
AUTH_SECRET=                   # session signing key; required for oidc. openssl rand -hex 32
# OIDC_ISSUER=https://your-tenant.us.auth0.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# PUBLIC_URL=http://localhost:3000   # the callback is PUBLIC_URL/api/auth/callback

# --- Limits (per user) ---
DAILY_TOKEN_BUDGET=300000      # 0 = unlimited
RATE_LIMIT_PER_MINUTE=20

# --- Demo ---
SEED_DEMO=true                 # docker compose seeds demo history for user "demo" on start
DEMO_TOOLS=true                # "demo tools" panel: load demo history, freeze the clock
MINICHAT_FAKE_NOW=             # ISO timestamp; freezes "now", e.g. 2026-11-11T14:05:00+05:30

# --- Running outside docker (npm run dev) against `docker compose up -d postgres redis` ---
# DATABASE_URL=postgres://minichat_app:minichat_app@localhost:5433/minichat
# MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/minichat
# REDIS_URL=redis://localhost:6380
