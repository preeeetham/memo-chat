# Copy to .env and fill in the two API keys. Everything else has a working default.
# Keep comments on their own lines: docker compose reads "KEY=   # note" as the value "# note".

# --- LLM (any OpenAI-compatible endpoint; defaults are for Gemini) ---
# Required. Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional: a cheaper model for planning and extraction (defaults to LLM_MODEL)
HELPER_MODEL=
# Optional: used when the main model is rate-limited or down (the answer is marked degraded)
LLM_FALLBACK_MODEL=
# Optional: hybrid recall (full text + vectors). Empty = full text only
EMBEDDING_MODEL=gemini-embedding-001

# --- Web search (the agent's one tool) ---
# Required for exa: https://exa.ai (free tier works)
EXA_API_KEY=
# exa | tavily
SEARCH_PROVIDER=exa
# Optional: e.g. tavily, used when the primary provider fails
SEARCH_FALLBACK_PROVIDER=
TAVILY_API_KEY=

# --- Sign-in ---
# password: email + password accounts and "Continue as guest" (the default when unset; use for deployments)
# dev: pick a username, no password (local only; docker compose uses this). oidc: a real identity provider
AUTH_MODE=dev
# Session signing key; required for password and oidc deployments. Generate with: openssl rand -hex 32
AUTH_SECRET=
# OIDC_ISSUER=https://your-tenant.us.auth0.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# The OIDC callback is PUBLIC_URL/api/auth/callback
# PUBLIC_URL=http://localhost:3000

# --- Limits (per user) ---
# Optional tokens per user per UTC day; 0 = unlimited (default). Gemini itself limits requests and tokens per minute, not per user
DAILY_TOKEN_BUDGET=0
RATE_LIMIT_PER_MINUTE=20

# --- Demo ---
# docker compose seeds demo history for user "demo" on start
SEED_DEMO=true
# The "demo tools" panel: load demo history, freeze the clock (server-wide). false for shared deployments
DEMO_TOOLS=true
# ISO timestamp that freezes "now", e.g. 2026-11-11T14:05:00+05:30
MEMOCHAT_FAKE_NOW=

# --- Running outside docker (npm run dev) against `docker compose up -d postgres redis migrate` ---
# The defaults already point at those ports; set these only to use another server.
# DATABASE_URL=postgres://memochat_app:memochat_app@localhost:5433/memochat
# MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/memochat
# REDIS_URL=redis://localhost:6380
